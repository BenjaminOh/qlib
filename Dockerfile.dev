FROM python:3.11-slim

WORKDIR /app

# Install build tools for Cython extensions
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ make && \
    rm -rf /var/lib/apt/lists/*

# Copy project files
COPY . .

# setuptools-scm needs git metadata for versioning; .git is excluded via .dockerignore
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.9.7

# Install dependencies and compile Cython extensions
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir cython numpy && \
    make prerequisite && \
    pip install --no-cache-dir -e .[dev]

COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["bash"]
