# Multi-stage production image for the qlib API + Celery worker + Celery beat.
# The same image is used by all three services; the docker-compose `command:`
# field decides which process to run.
#
# Stage 1: build the Cython extensions and resolve all wheels.
# Stage 2: slim runtime that only contains compiled .so files + site-packages.

# ─── Stage 1: build ─────────────────────────────────────────────
FROM python:3.11-slim AS build

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc g++ make build-essential && \
    rm -rf /var/lib/apt/lists/*

ARG SETUPTOOLS_SCM_PRETEND_VERSION=0.9.7
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${SETUPTOOLS_SCM_PRETEND_VERSION}

# Layer ordering is tuned for cache hit rate on Jenkins:
#   1) build prerequisites (almost never change) → cached forever
#   2) FastAPI deps from requirements.txt (changes occasionally)
#   3) qlib package + Cython compile (changes per commit, but pip wheel
#      downloads are reused from the BuildKit cache mount)
# `make prerequisite` runs the .pyx -> .cpp -> .so pipeline; direct
# `cython --cplus` only does .pyx -> .cpp.

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install cython numpy

COPY app/api/requirements.txt ./app/api/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r app/api/requirements.txt

COPY pyproject.toml setup.py MANIFEST.in Makefile ./
COPY qlib/ ./qlib/
RUN --mount=type=cache,target=/root/.cache/pip \
    make prerequisite && pip install .

# scripts/ is deliberately COPIED AFTER the pyqlib install layer: it is not
# packaged (MANIFEST.in ships qlib/* only) and it changes far more often than
# the qlib core. Coupling it to the layer above forced a full Cython
# compile + wheel build (~5+ min) on every scripts-only change — the main
# reason deploys took 30-40 minutes.
COPY scripts/ ./scripts/



# ─── Stage 1b: test gate ────────────────────────────────────────
# Inherits `build`, which already has fastapi / sqlalchemy / redis / requests /
# qlib installed. That matters: every file in tests/app guards its imports with
# `pytest.importorskip(...)`, so on a machine missing those deps the whole suite
# SKIPS and pytest still exits 0 — a green light that proves nothing. The login
# lockout defect survived exactly that way (the test failed, but CI never ran
# it). So the gate runs where the deps are real, and treats any skip as failure.
#
# Only app/api is copied — app/frontend is 612MB and irrelevant here.
# This stage is never referenced by the runtime image; it runs only when the
# build is invoked with `--target test` (Jenkinsfile's Test stage).
FROM build AS test

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install pytest

COPY app/api ./app/api
COPY app/__init__.py ./app/__init__.py
COPY tests/ ./tests/
# 전략 카탈로그 정합성 테스트가 프론트 목록도 대조한다 — 이 파일이 없으면
# 그 검사가 skip 되어 게이트에 구멍이 난다(2026-09-07 추가).
COPY app/frontend/src/lib/strategies.ts ./app/frontend/src/lib/strategies.ts

# 종료코드를 반드시 먼저 본다. 최초 구현은 `pytest | tee` 를 `;` 로 끝내
# 종료코드를 버리고 "N passed" 문자열만 grep 했는데, 실패 요약도
# "1 failed, 227 passed" 라 그 grep 을 통과해 버렸다 — 실패를 통과시키는
# 게이트였다(2026-08-19 음성 검증에서 발각). pipefail 은 Docker 기본 셸
# dash 에서 미지원이므로 쓰지 않고, rc 를 직접 잡는다.
RUN python -m pytest tests/app -q -p no:cacheprovider --no-header -ra \
        > /tmp/pytest.out 2>&1; \
    rc=$?; \
    cat /tmp/pytest.out; \
    [ "$rc" -eq 0 ] \
      || { echo "게이트 실패: pytest 종료코드 $rc"; exit 1; }; \
    grep -qE "[0-9]+ passed" /tmp/pytest.out \
      || { echo "게이트 실패: 통과한 테스트가 없다"; exit 1; }; \
    ! grep -qE "[0-9]+ skipped" /tmp/pytest.out \
      || { echo "게이트 실패: skip 발생 — 의존성 누락으로 테스트가 무력화됐다"; exit 1; }

# ─── Stage 2: runtime ───────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Build args propagated for runtime introspection (matches likeweb/pm pattern).
ARG BUILD_TIME=unknown
ARG GIT_COMMIT=unknown
ENV BUILD_TIME=${BUILD_TIME} \
    GIT_COMMIT=${GIT_COMMIT} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Seoul

# Minimal runtime libs (libgomp for LightGBM, libpq for PostgreSQL).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgomp1 libpq5 curl ca-certificates tzdata && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    rm -rf /var/lib/apt/lists/*

# Pull installed packages + compiled .so files from the build stage.
COPY --from=build /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /app/qlib /app/qlib
COPY --from=build /app/scripts /app/scripts

# Application code (only what's needed at runtime).
COPY app/api ./app/api
COPY app/__init__.py ./app/__init__.py

# Stock-name mapping must travel with the image so live UI shows names.
COPY app/api/core/kr_stock_names.json ./app/api/core/kr_stock_names.json

EXPOSE 5001

# Default command — overridden by docker-compose for the worker / beat services.
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "5001"]
