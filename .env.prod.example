# Copy this file to /home/qlib/.env on the host (rocky-monitor) and edit
# the placeholders. KIS keys not yet issued? Leave the PASTE_... defaults
# in place — KISClient auto-detects mock mode.
#
# IMPORTANT: docker compose .env parser is literal-only — no ${VAR}
# cross-references between lines. Set every value explicitly.

# ── KIS Open API (paper trading) ───────────────────────────────
KIS_ENV=paper
KIS_APP_KEY=PASTE_PAPER_APPKEY_HERE
KIS_APP_SECRET=PASTE_PAPER_APPSECRET_HERE
KIS_ACCOUNT_NO=12345678-01

QLIB_API_KIS_ENV=paper
QLIB_API_KIS_APP_KEY=PASTE_PAPER_APPKEY_HERE
QLIB_API_KIS_APP_SECRET=PASTE_PAPER_APPSECRET_HERE
QLIB_API_KIS_ACCOUNT_NO=12345678-01
QLIB_API_KIS_ACCOUNT_PRODUCT=01

# ── Redis (qlib_redis container managed by docker-compose.prod.yml) ──
REDIS_URL=redis://qlib_redis:6379/0

# ── Live trading DB ─────────────────────────────────────────────
# SQLite for paper trading. Switch to PostgreSQL on global_shared_db
# when promoting to real trading.
LIVE_DB_URL=sqlite:////app/db/live.sqlite

# ── Frontend / CORS ─────────────────────────────────────────────
# IMPORTANT: NEXT_PUBLIC_API_URL is a hostname only (no /api suffix).
# api.ts already prefixes every endpoint with /api/v1/..., and combining
# the two would produce /api/api/v1/... → 404.
NEXT_PUBLIC_API_URL=https://qlib.tmanager.kr
CORS_ORIGINS=["https://qlib.tmanager.kr"]

# ── Admin auth (FastAPI JWT + Next.js login page) ──────────────
# JWT_SECRET: generate with `openssl rand -hex 32` (64 hex chars).
# Rotating it invalidates all existing sessions — users must re-login.
# ADMIN_USERNAME / ADMIN_PASSWORD are seeded into the users table on the
# very first startup (idempotent — subsequent boots are no-ops). To change
# the password later, update the password_hash row in the live.sqlite DB
# directly or add a small admin CLI (out of scope for now).
QLIB_API_JWT_SECRET=PASTE_64_HEX_CHARS_HERE
QLIB_API_ADMIN_USERNAME=admin
QLIB_API_ADMIN_PASSWORD=PASTE_STRONG_PASSWORD_HERE
