# Copy to /home/qlib/.env on the production host (rocky-monitor) and fill in values.
# Do NOT commit a real .env to git.

# ── KIS Open API (모의투자 키 우선)
QLIB_API_KIS_ENV=paper
QLIB_API_KIS_APP_KEY=PASTE_PAPER_APPKEY_HERE
QLIB_API_KIS_APP_SECRET=PASTE_PAPER_APPSECRET_HERE
QLIB_API_KIS_ACCOUNT_NO=12345678-01
QLIB_API_KIS_ACCOUNT_PRODUCT=01

# Aliases consumed by docker-compose.prod.yml (so we don't have to repeat the prefix):
KIS_ENV=paper
KIS_APP_KEY=${QLIB_API_KIS_APP_KEY}
KIS_APP_SECRET=${QLIB_API_KIS_APP_SECRET}
KIS_ACCOUNT_NO=${QLIB_API_KIS_ACCOUNT_NO}

# ── Redis (rocky-monitor's existing instance OR a new one)
# If you re-use the existing global redis, set host accordingly.
REDIS_URL=redis://redis-shared:6379/2

# ── Live trading DB. SQLite default works for paper trading; switch to
#    PostgreSQL on the existing global_shared_db when going live.
# LIVE_DB_URL=sqlite:////app/db/live.sqlite
LIVE_DB_URL=postgresql+psycopg2://qlib_trader:STRONG_PASSWORD@global_shared_db:5432/qlib_trader

# ── Frontend public API URL (rendered into Next.js client bundle at build time)
NEXT_PUBLIC_API_URL=https://qlib.tmanager.kr/api

# ── CORS origins for the FastAPI app
CORS_ORIGINS=["https://qlib.tmanager.kr"]
